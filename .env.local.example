# Variables de entorno — SOLO nombres, sin valores reales.
# Los valores del admin te los dieron en el chat: cárgalos en
#   Vercel → Project → Settings → Environment Variables
# (y para pruebas en tu PC, en un archivo .env.local que NO se sube a GitHub).

ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SECRET=

# Se crean solas al conectar Storage en Vercel:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# BLOB_READ_WRITE_TOKEN=
